# Copie para .env e ajuste. O .env é lido automaticamente pelo docker compose.
# Os valores abaixo são defaults de desenvolvimento — NÃO use em produção.

# PostgreSQL / PostGIS
POSTGRES_DB=dimap_geocode
POSTGRES_USER=dimap
POSTGRES_PASSWORD=dimap
DB_PORT=5432

# Django
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_AUTO_MIGRATE=1
DJANGO_AUTO_SEED=1
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
WEB_PORT=8000

# Daemon de atualização dos dados (profile `atualizacao`) — horário diário HH:MM, fuso do projeto
DTIME_ATUALIZACAO_ARQUIVOS=03:00

# WFS — resiliência a timeout/conexão (opcional; os defaults abaixo espelham o WfsRetryPolicy)
# WFS_REQUEST_TIMEOUT_SECONDS=30.0
# WFS_MAX_RETRIES=3
# WFS_RETRY_WAIT_MIN_SECONDS=1.0
# WFS_RETRY_WAIT_MAX_SECONDS=5.0

# WMS — teto de espera do GetMap (sem ele uma conexão pendurada trava quem chamou)
# WMS_REQUEST_TIMEOUT_SECONDS=30.0
# Último zoom com detalhe real na ortofoto; acima dele o Leaflet amplia o tile no cliente.
# Trocar a camada de ortofoto por outra resolução pede rever este número.
# WMS_ZOOM_NATIVO_ORTOFOTO=20

# Ortofotos de fundo da área administrativa — sobrescreve config/pontos_fundo.json inteiro.
# Formato: mesmo JSON do arquivo (chave = nome do .png gerado).
# MAP_FUNDO_PONTOS={"anhangabau": {"descricao": "...", "lat": -23.545, "lng": -46.639}}

# E-mail — SMTP do Gmail. A senha é uma "senha de app" da conta, não a senha de login.
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORTA=587
EMAIL_SMTP_USUARIO=
EMAIL_SMTP_SENHA=
EMAIL_REMETENTE_NOME=DIMAP GeoCoder
EMAIL_ENVIO_HABILITADO=0
# Resiliência a timeout/conexão (opcional; os defaults espelham o SmtpRetryPolicy)
# EMAIL_SMTP_TIMEOUT_SECONDS=30.0
# EMAIL_SMTP_MAX_RETRIES=2
# EMAIL_SMTP_RETRY_WAIT_MIN_SECONDS=1.0
# EMAIL_SMTP_RETRY_WAIT_MAX_SECONDS=5.0

# Fecha o cadastro de servidor pela tela aos domínios institucionais. Desligue só em ambiente de teste.
ENFORCE_PREFEITURA_EMAIL=1

# Reenvio da senha de uso único (opcional; sem a chave vale o default ao lado). Número vazio não
# entra num int — opcional aqui se escreve comentado, como as demais chaves numéricas.
# JANELA_REENVIO_SEGUNDOS=120
# PRAZO_MESMA_SENHA_SEGUNDOS=300
# PRAZO_SENHA_ANTERIOR_SEGUNDOS=86400

# Selo de integridade do documento oficial (services.utils.assinatura). Troque em produção —
# o default abaixo é o mesmo tipo de valor inseguro do DJANGO_SECRET_KEY.
# ASSINATURA_SEGREDO=dev-insecure-assinatura-secret-troque-me
# ASSINATURA_ID_CHAVE=k1
